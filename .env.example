# Salin menjadi .env untuk mengaktifkan Mode LLM di tab Musyawarah.
# Bisa juga diset sebagai environment variable Windows.

OPENAI_API_KEY=

# Lapisan pos X tidak memakai API berbayar dan tidak butuh kunci.
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-reasoner

# Catatan: default base URL di llm.py mengarah ke DeepSeek. Jika memakai OpenAI
# (mis. LLM_MODEL=gpt-4o), WAJIB set OPENAI_BASE_URL=https://api.openai.com/v1
# agar API key tidak terkirim ke endpoint yang salah.

# Prompt sistem Mode LLM. Default memakai berkas MD bawaan (llm.py PROMPT_PATH).
# Arahkan ke berkas .md/.txt sendiri untuk override. Hanya nama aman yang
# diekspos lewat /api/llm/status (bukan path absolut); berkas titik (.env dll)
# dan ekstensi lain ditolak. Dapat diubah tanpa restart (dibaca lazily).
# LLM_PROMPT_PATH=prompt-kustom.md

# Base URL kanonik publik untuk <link rel="canonical">, /robots.txt, /sitemap.xml,
# og:image, dan twitter:image. WAJIB diset absolut di produksi agar URL mesin
# pencari & kartu berbagi (FB/X/WhatsApp/LinkedIn) konsisten. Bila kosong,
# jalur relatif dipakai (fail-safe) — kode TIDAK memakai request.host_url
# (anti Host-spoof/cache poisoning). Contoh: https://laumology.onrender.com
# LAUM_PUBLIC_BASE_URL=https://laumology.example

# Token verifikasi Google Search Console (URL-prefix). Bila diset, dirender
# sebagai <meta name="google-site-verification" content="..."> di <head> index.
# Token GSC bersifat publik (tampil di HTML), bukan rahasia. Nilai divalidasi
# ketat (hanya [A-Za-z0-9_-]); kosong/invalid → tag tidak dirender (fail-safe).
# LAUM_GOOGLE_SITE_VERIFICATION=RnwQXP6N7GmFJnEJwvC_cPmgesMpyroVameSBPihrKE

# Proteksi endpoint tulis (/api/paper/open, /api/paper/close, /api/notify).
# Bila kosong, endpoint tersebut TERBUKA. Set nilainya lalu kirim header X-API-Key.
API_KEY=

# Opsional: webhook notifikasi (dipakai scheduler.py / alert)
IDX_ALERT_WEBHOOK=

# Jumlah hop proxy tepercaya untuk memulihkan IP klien asli dari
# X-Forwarded-For via ProxyFix (mis. Render butuh 1). Default 0 = nonaktif
# (perilaku lama). Hanya set >0 bila app benar-benar di belakang proxy;
# bila app diekspos langsung, nilai >0 membuat rate-limit bisa dilewati
# dengan memalsukan X-Forwarded-For. Nilai di-clamp ke rentang 0..5.
# TRUSTED_PROXY_HOPS=1

# Batas ukuran body request (byte) untuk SEMUA endpoint. Mencegah POST besar
# memicu OOM/DoS di instance ber-RAM kecil. Default 1 MB; nilai di-clamp ke
# rentang 64KB..8MB. Nilai tidak valid atau <= 0 dikembalikan ke default
# (tidak melumpuhkan endpoint). Lewat batas -> HTTP 413.
# LAUM_MAX_BODY_BYTES=1048576

# --- Override flag penting config.py (prefix LAUM_, 12-factor) ---
# Semua dikomentari. Bila tidak diset, nilai default di config.py tetap dipakai.
# Bool: 1/0, true/false, yes/no, on/off (case-insensitive).
# Nilai tidak valid diabaikan + warning (tidak membuat aplikasi crash).
# LAUM_REGIME_FILTER=false
# LAUM_ENABLE_DECISION=false
# LAUM_USE_OPTIMIZED_SCORE=false
# Float:
# LAUM_MIN_DATA_QUALITY=40.0
# LAUM_ML_BLEND_ALPHA=0.5
# LAUM_MIN_OOS_AUC=0.53
# Int:
# LAUM_SCREEN_WORKERS=0
# LAUM_SWING_HORIZON_DAYS=10
