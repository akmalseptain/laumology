//@version=5
indicator("IDX All-in-One Pro (Score/Conf/Entry-TP-SL)", overlay=true, max_lines_count=500, max_labels_count=500)

grpMa  = "Moving Averages"
grpInd = "Indicators"
grpRis = "Risk (Entry/TP/SL)"
grpSig = "Signals"

maShort  = input.int(20,  "MA Short",  group=grpMa)
maMid    = input.int(50,  "MA Mid",    group=grpMa)
maLong   = input.int(200, "MA Long",   group=grpMa)
emaMid   = input.int(21,  "EMA Mid",   group=grpMa)

rsiLen   = input.int(14,  "RSI",              group=grpInd)
atrLen   = input.int(14,  "ATR",              group=grpInd)
adxLen   = input.int(14,  "ADX",              group=grpInd)
stPer    = input.int(10,  "Supertrend Period",group=grpInd)
stMult   = input.float(3.0,"Supertrend Mult", group=grpInd)
breakout = input.int(20,  "Breakout Window",  group=grpInd)

atrSlMult = input.float(2.0, "ATR Stop x",  group=grpRis)
tp1RR     = input.float(1.5, "TP1 RR",      group=grpRis)
tp2RR     = input.float(3.0, "TP2 RR",      group=grpRis)
tp3RR     = input.float(4.5, "TP3 RR",      group=grpRis)

strongScore = input.int(80, "Strong Buy Score", group=grpSig)
buyScore    = input.int(65, "Buy Score",        group=grpSig)
sellScore   = input.int(40, "Sell Score",       group=grpSig)
showTable   = input.bool(true, "Show score table", group=grpSig)

ma20  = ta.sma(close, maShort)
ma50  = ta.sma(close, maMid)
ma200 = ta.sma(close, maLong)
ema21 = ta.ema(close, emaMid)

rsi   = ta.rsi(close, rsiLen)
atr   = ta.atr(atrLen)
atrPct= atr / close * 100
[macdLine, signalLine, hist] = ta.macd(close, 12, 26, 9)
[bbM, bbU, bbL] = ta.bb(close, 20, 2.0)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
[stLine, stDir] = ta.supertrend(stMult, stPer)
stUp = stDir < 0

tenkan = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2
kijun  = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
senkouA = ((tenkan + kijun) / 2)[26]
senkouB = ((ta.highest(high, 52) + ta.lowest(low, 52)) / 2)[26]
aboveCloud = close > senkouA and close > senkouB

rsiLo = ta.lowest(rsi, rsiLen)
rsiHi = ta.highest(rsi, rsiLen)
stochRsi = rsiHi > rsiLo ? (rsi - rsiLo) / (rsiHi - rsiLo) : 0.5
cci = ta.cci(hlc3, 20)
mfi = ta.mfi(hlc3, 14)
volMa = ta.sma(volume, 20)
obv   = ta.obv
obvMa = ta.sma(obv, 20)
mfm = high > low ? ((close - low) - (high - close)) / (high - low) : 0.0
cmf = ta.sma(mfm * volume, 21) / ta.sma(volume, 21)
highW = ta.highest(high, breakout)
low20 = ta.lowest(low, 20)

body   = math.abs(close - open)
rng    = math.max(high - low, syminfo.mintick)
upperW = high - math.max(open, close)
lowerW = math.min(open, close) - low
bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
hammer     = lowerW >= 2 * body and upperW <= body and body <= 0.4 * rng
maruBull   = close > open and body >= 0.9 * rng
bullCandle = bullEngulf or hammer or maruBull

trendC = (close > ma20 ? 3 : 0) + (ma20 > ma50 ? 3 : 0) + (ma50 > ma200 ? 4 : 0) + (close > ma200 ? 3 : 0) + (stUp ? 4 : 0) + (aboveCloud ? 3 : 0)
trendC := math.min(trendC, 20)
momC = (rsi >= 50 and rsi <= 70 ? 4 : 0) + (rsi > 70 ? 1 : 0) + (rsi < 30 ? 2 : 0) + (macdLine > signalLine ? 4 : 0) + (hist > 0 ? 4 : 0) + (hist > hist[1] ? 3 : 0) + (stochRsi > 0.5 ? 1 : 0) + (cci > 0 ? 1 : 0)
momC := math.min(momC, 20)
strC = (adx >= 25 and diPlus > diMinus ? 8 : 0) + (adx >= 20 and adx < 25 and diPlus > diMinus ? 4 : 0) + (adx > adx[3] ? 3 : 0)
strC := math.min(strC, 15)
volC = (volume > 1.2 * volMa ? 5 : 0) + (obv > obvMa ? 4 : 0) + (cmf > 0 ? 3 : 0) + (mfi > 50 ? 3 : 0)
volC := math.min(volC, 15)
setC = (close >= highW * 0.99 ? 5 : 0) + (bullCandle ? 4 : 0) + (close > ema21 and close <= ema21 * 1.02 and stUp ? 3 : 0) + (close >= bbU * 0.995 ? 3 : 0)
setC := math.min(setC, 15)
riskC = (atrPct < 3 ? 6 : 0) + (atrPct >= 3 and atrPct < 5 ? 3 : 0) + (rsi < 78 ? 3 : 0) + (close > ma50 ? 3 : 0)
riskC := math.min(riskC, 15)

score = math.round(math.min(trendC + momC + strC + volC + setC + riskC, 100))

f1 = close > ma50
f2 = ma50 > ma200
f3 = close > ma200
f4 = stUp
f5 = aboveCloud
f6 = macdLine > signalLine
f7 = hist > 0
f8 = rsi >= 50 and rsi <= 78
f9 = adx >= 20 and diPlus > diMinus
f10 = volume > 1.2 * volMa
f11 = obv > obvMa
f12 = cmf > 0
f13 = close >= highW * 0.99
f14 = bullCandle
f15 = mfi > 50
conf = math.round(( (f1?1:0)+(f2?1:0)+(f3?1:0)+(f4?1:0)+(f5?1:0)+(f6?1:0)+(f7?1:0)+(f8?1:0)+(f9?1:0)+(f10?1:0)+(f11?1:0)+(f12?1:0)+(f13?1:0)+(f14?1:0)+(f15?1:0) ) / 15 * 100)

uptrend   = close > ma50 and ma50 > ma200
extended  = rsi > 68 or close >= bbU * 0.995
breakoutB = close >= highW * 0.99

slRaw = math.min(close - atrSlMult * atr, low20 - 0.3 * atr)
risk  = math.max(close - slRaw, 0.4 * atr)
sl    = close - risk
tp1   = close + tp1RR * risk
tp2   = close + tp2RR * risk
tp3   = close + tp3RR * risk

buySignal    = score >= buyScore and uptrend
strongSignal = score >= strongScore and uptrend
sellSignal   = score <= sellScore
action = strongSignal ? (extended ? "BELI BERTAHAP" : "BELI SEKARANG") : buySignal ? (breakoutB ? "BELI BREAKOUT" : "BELI") : sellSignal ? "JUAL / HINDARI" : "TAHAN"
grade = score >= 85 and conf >= 70 and uptrend ? "A+" : score >= 78 and conf >= 60 and uptrend ? "A" : score >= 65 and conf >= 50 ? "B" : score >= 50 ? "C" : "D"

var float actEntry = na
var float actSL    = na
var float actTP1   = na
var float actTP2   = na
var float actTP3   = na
var bool  inPos    = false

if buySignal and not inPos
    inPos    := true
    actEntry := close
    actSL    := sl
    actTP1   := tp1
    actTP2   := tp2
    actTP3   := tp3

if inPos and (low <= actSL or high >= actTP3 or (not uptrend and score < sellScore))
    inPos := false

plot(ma20,  "MA20",  color=color.new(color.orange, 0),  linewidth=1)
plot(ma50,  "MA50",  color=color.new(color.blue, 0),    linewidth=1)
plot(ma200, "MA200", color=color.new(color.purple, 0),  linewidth=2)
plot(ema21, "EMA21", color=color.new(color.teal, 0),    linewidth=1)
plot(senkouA, "SpanA", color=color.new(color.gray, 40))
plot(senkouB, "SpanB", color=color.new(color.gray, 40))
plot(stUp ? stLine : na, "Supertrend Up", color=color.new(#26a69a, 0), linewidth=2)
plot(not stUp ? stLine : na, "Supertrend Down", color=color.new(#ef5350, 0), linewidth=2)

plot(inPos ? actEntry : na, "Entry", color=color.new(color.navy, 0),  style=plot.style_linebr, linewidth=2)
plot(inPos ? actSL    : na, "SL",    color=color.new(color.red, 0),   style=plot.style_linebr, linewidth=2)
plot(inPos ? actTP1   : na, "TP1",   color=color.new(color.green, 0), style=plot.style_linebr, linewidth=1)
plot(inPos ? actTP2   : na, "TP2",   color=color.new(color.green, 0), style=plot.style_linebr, linewidth=1)
plot(inPos ? actTP3   : na, "TP3",   color=color.new(color.teal, 0),  style=plot.style_linebr, linewidth=2)

plotshape(buySignal,    title="BUY",    style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, text="BUY", size=size.small)
plotshape(strongSignal, title="STRONG", style=shape.labelup,   location=location.belowbar, color=color.new(color.lime, 0),  textcolor=color.black, text="STRONG", size=size.small)
plotshape(sellSignal,   title="SELL",   style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0),   textcolor=color.white, text="SELL", size=size.small)

bgcolor(strongSignal ? color.new(color.green, 88) : buySignal ? color.new(color.green, 92) : sellSignal ? color.new(color.red, 90) : na)

var table tbl = table.new(position.top_right, 2, 10, border_width=1)

if barstate.islast and showTable
    table.cell(tbl, 0, 0, "IDX SCORE", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(tbl, 1, 0, str.tostring(score) + "/100  (" + str.tostring(conf) + "%)", text_color=color.white, bgcolor=color.new(buySignal or strongSignal ? color.green : sellSignal ? color.red : color.gray, 0))
    table.cell(tbl, 0, 1, "Sinyal", text_color=color.black)
    table.cell(tbl, 1, 1, (strongSignal ? "STRONG BUY" : buySignal ? "BUY" : sellSignal ? "SELL" : "HOLD"), text_color=buySignal or strongSignal ? color.green : sellSignal ? color.red : color.gray)
    table.cell(tbl, 0, 2, "Aksi", text_color=color.black)
    table.cell(tbl, 1, 2, action, text_color=color.black)
    table.cell(tbl, 0, 3, "Grade", text_color=color.black)
    table.cell(tbl, 1, 3, grade, text_color=color.black)
    table.cell(tbl, 0, 4, "ADX / DI", text_color=color.black)
    table.cell(tbl, 1, 4, str.tostring(math.round(adx,0)) + "  +" + str.tostring(math.round(diPlus,0)) + "/-" + str.tostring(math.round(diMinus,0)), text_color=color.black)
    table.cell(tbl, 0, 5, "RSI", text_color=color.black)
    table.cell(tbl, 1, 5, str.tostring(math.round(rsi,1)), text_color=color.black)
    table.cell(tbl, 0, 6, "ATR %", text_color=color.black)
    table.cell(tbl, 1, 6, str.tostring(math.round(atrPct,2)) + "%", text_color=color.black)
    table.cell(tbl, 0, 7, "Tren", text_color=color.black)
    table.cell(tbl, 1, 7, uptrend ? "UP" : "DOWN", text_color=uptrend ? color.green : color.red)
    table.cell(tbl, 0, 8, "TP2 / RR", text_color=color.black)
    table.cell(tbl, 1, 8, str.tostring(math.round(tp2,0)) + "  1:" + str.tostring(tp2RR, "#.#"), text_color=color.black)
    table.cell(tbl, 0, 9, "SL", text_color=color.black)
    table.cell(tbl, 1, 9, str.tostring(math.round(sl,0)), text_color=color.red)

alertcondition(buySignal,    "BUY Signal",    "Sinyal BUY terdeteksi")
alertcondition(strongSignal, "STRONG BUY",    "Sinyal STRONG BUY terdeteksi")
alertcondition(sellSignal,   "SELL Signal",   "Sinyal SELL terdeteksi")
