{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-flash",
  "instructions": [".opencode/warroom/OPERATING_PROTOCOL.md"],
  "autoupdate": "notify",
  "compaction": { "auto": true, "tail_turns": 10 },
  "tool_output": { "max_lines": 160, "max_bytes": 12000 },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git reset *": "deny",
      "git clean *": "deny",
      "git push *": "allow",
      "git filter-branch *": "deny",
      "git rebase *": "deny",
      "rm -rf *": "deny",
      "Remove-Item -Recurse *": "deny",
      "npm publish *": "deny",
      "vercel deploy *": "deny",
      "vercel --prod *": "deny"
    },
    "webfetch": "allow"
  }
}
